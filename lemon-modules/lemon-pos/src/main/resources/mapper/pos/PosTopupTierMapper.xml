<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.lemon.erp.modules.pos.mapper.PosTopupTierMapper">

    <insert id="insertBatch">
        INSERT INTO pos_topup_tier (min_amount, bonus_amount, create_time, update_time) VALUES
        <foreach collection="list" item="t" separator=",">
            (#{t.minAmount}, #{t.bonusAmount}, NOW(), NOW())
        </foreach>
    </insert>

</mapper>
